# Cloudflare Pages 构建配置
#
# 关键点：本地开发/构建时沙箱可能拦截 .next 目录写入，
# 因此把构建中间目录指向 /tmp（Cloudflare 环境无需此设置，但保持一致可避免本地构建被拦）。
NEXT_DIST_DIR=/tmp/blog-next

# 项目页无需 BASE_PATH（部署在域名根目录），保持为空
BASE_PATH=

# Next.js 14 需要 Node >= 18.17。Node 版本用根目录 .node-version 指定（22）——
# Cloudflare Pages 在构建前读取该文件决定 Node 版本，不能只依赖本文件。
NODE_ENV=production